{
  "manifest_version": 3,
  "name": "PageKit — SEO & Markdown",
  "short_name": "PageKit",
  "version": "0.1.0",
  "description": "Turn any page into clean Markdown, convert Markdown to HTML, and export the page's SEO as JSON, TypeScript or Next.js metadata.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Open PageKit",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["sidePanel", "scripting", "storage"],
  "optional_host_permissions": ["<all_urls>"]
}
