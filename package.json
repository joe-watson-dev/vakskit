{
  "name": "vakskit",
  "description": "Chrome extension to understand any web page: SEO export (JSON, TypeScript, HTML), page to Markdown, fonts and type scale, Markdown to HTML.",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "author": {
    "name": "Joe Watson SBF",
    "email": "watsonjoe40@gmail.com",
    "url": "https://joedev.vakaks.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joe-watson-dev/vakskit.git"
  },
  "homepage": "https://github.com/joe-watson-dev/vakskit#readme",
  "bugs": {
    "url": "https://github.com/joe-watson-dev/vakskit/issues"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "build": "pnpm typecheck && vite build",
    "icons": "node scripts/make-icons.mjs",
    "zip": "pnpm build && cd dist && zip -qr ../vakskit.zip .",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "defuddle": "^0.19.6",
    "dompurify": "^3.4.17",
    "marked": "^18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turndown": "^7.2.5",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5"
  }
}
